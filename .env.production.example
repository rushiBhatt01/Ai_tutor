# TEMPLATE ONLY. Store actual runtime secrets in .local-secrets/runtime.env
# or outside this repository. Never commit or print the real runtime file.
TARGET_PLATFORM=linux/arm64
SITE_ADDRESS=localhost
PUBLIC_BIND_IP=127.0.0.1
API_USERNAME=
API_PASSWORD=
# bcrypt hash of the SAME API_PASSWORD, single-quoted to preserve $ in Compose
PROXY_PASSWORD_HASH=''
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=
MONGO_APP_PASSWORD=
# Percent-encode credentials. Use the app user, not the root user.
MONGO_URI=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
GEMINI_API_KEY=
PIXABAY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
IMAGE_PROVIDERS=pixabay,wikimedia_commons,unsplash
IMAGE_SEARCH_ENABLED=true
JOB_QUEUE_CAPACITY=4
JOB_TIMEOUT_SECONDS=1800
JOB_MAX_ATTEMPTS=2
TEMP_MAX_MB=4096
# Persistent filesystem by default. OCI storage stays disabled until separately
# verified and approved; the adapter does not provision buckets or IAM resources.
ARTIFACT_BACKEND=local
OCI_STORAGE_APPROVED=false
OCI_STORAGE_NAMESPACE=
OCI_STORAGE_BUCKET=
