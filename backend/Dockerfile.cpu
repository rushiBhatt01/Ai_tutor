FROM python:3.11.14-slim-bookworm@sha256:65a93d69fa75478d554f4ad27c85c1e69fa184956261b4301ebaf6dbb0a3543d

ARG TARGETARCH

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    CUDA_VISIBLE_DEVICES="" OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 MPLCONFIGDIR=/tmp/matplotlib
WORKDIR /app

# Freeze Debian and security repositories together; snapshot metadata may be
# expired, while Release signatures remain verified by APT.
RUN rm -f /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list \
    && printf '%s\n' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20261001T000000Z bookworm main' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20261001T000000Z bookworm-security main' \
      > /etc/apt/sources.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg bubblewrap build-essential pkg-config python3-dev ninja-build \
    libcairo2-dev libpango1.0-dev libgl-dev libgl1 libglib2.0-0 \
    fonts-dejavu-core ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.cpu.lock /app/requirements.cpu.lock
COPY backend/requirements.cpu-build.lock /app/requirements.cpu-build.lock
# The production build is deliberately ARM64 only. Hashes pin the actual PyPI
# artifacts (including the CPU-only ARM torch wheels), not just version names.
RUN test "$TARGETARCH" = arm64 \
    && python -m pip install --no-cache-dir --require-hashes -r requirements.cpu-build.lock \
    && python -m pip install --no-cache-dir --no-build-isolation --require-hashes -r requirements.cpu.lock \
    && pip check

RUN groupadd --gid 10001 tutor && useradd --uid 10001 --gid tutor --create-home tutor \
    && mkdir -p /data/state /data/runs /data/artifacts /data/model-cache \
    && chown -R tutor:tutor /data
# Copy source and portraits only; never copy caches, env files, keys or weights.
COPY --chown=tutor:tutor backend/*.py /app/
COPY --chown=tutor:tutor backend/functions /app/functions
COPY --chown=tutor:tutor backend/characters /app/characters
USER 10001:10001
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
