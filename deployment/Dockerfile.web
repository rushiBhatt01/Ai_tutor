FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94 AS frontend
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY frontend/topic2explanation/package.json frontend/topic2explanation/package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY frontend/topic2explanation ./
ENV NEXT_PUBLIC_API_BASE_URL=/backend
RUN npm run build

FROM caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
COPY deployment/Caddyfile /etc/caddy/Caddyfile
COPY --from=frontend /app/out /srv
